{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Frisket 主窗口权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
